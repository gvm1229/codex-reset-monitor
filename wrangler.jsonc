{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tibo-codex-monitor",
  "main": "src/index.js",
  "compatibility_date": "2026-07-15",
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "STATE",
      "id": "1ab72f1162434a2da404543604377549"
    }
  ]
}
