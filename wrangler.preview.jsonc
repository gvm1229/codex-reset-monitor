{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tibo-codex-monitor-v0-10-preview",
  "main": "src/index.js",
  "compatibility_date": "2026-07-15",
  "workers_dev": true,
  "observability": { "enabled": true },
  "triggers": { "crons": [] },
  "vars": {
    "NOTIFICATIONS_ENABLED": "false",
    "DISCORD_TEST_ENABLED": "false",
    "PREVIEW_POLL_ENABLED": "true",
    "MONITOR_NAMESPACE": "codex-reset:v1:preview-0-10",
    "SOURCE_CONTACT_URL": "https://tibo-codex-monitor.hojini1229.workers.dev"
  },
  "durable_objects": {
    "bindings": [{ "name": "MONITOR", "class_name": "MonitorCoordinator" }]
  },
  "migrations": [{ "tag": "v0-8", "new_sqlite_classes": ["MonitorCoordinator"] }]
}
